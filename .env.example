# Copie para .env e preencha. O .env é ignorado pelo git; nunca comite valores reais.

# Supabase / Lovable Cloud
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Agora Conversational AI (projeto com Conversational AI habilitado)
# App ID e App Certificate: 32 caracteres hexadecimais, do Console da Agora.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Ao menos 32 caracteres aleatórios. Gere com: openssl rand -hex 32
AGORA_REVIEW_SECRET=
# ID de uma voz MiniMax disponível no projeto, preferencialmente em pt-BR.
AGORA_TTS_VOICE_ID=

# Origem HTTPS pública do app, sem caminho. A Agora chama o Custom LLM nesta origem.
PUBLIC_APP_URL=

# Inferência no servidor.
NEURALAKE_API_KEY=
